# Secrets — never commit these
.env

# Debug session files (contain login credentials)
ssh_connection.txt
pinggy_ssh.log
vscode_cf.log

# VS Code Server session data
.vscode-session/

# Logs
logs/
*.log

# Temp recordings and cache
/tmp/camera-recordings/
temp_vods/

# Generated reports and snapshots
report.txt
snapshot_*.jpg

# Python cache
__pycache__/


